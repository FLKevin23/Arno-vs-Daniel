{
  "name": "arno-vs-daniel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram-verified vote: who has more namesakes in the group, the Arnos or the Daniels?",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "check": "npm run typecheck && npm run lint",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "functions:deploy": "firebase deploy --only functions",
    "deploy:backend": "firebase deploy --only firestore:rules,functions"
  },
  "dependencies": {
    "firebase": "10.14.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.8.0",
    "@typescript-eslint/parser": "8.8.0",
    "eslint": "9.12.0",
    "firebase-tools": "13.22.1",
    "typescript": "5.6.3",
    "vite": "5.4.9"
  },
  "engines": {
    "node": ">=20"
  }
}
